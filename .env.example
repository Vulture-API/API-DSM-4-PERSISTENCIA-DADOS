PERSIST_REDIS_URL=redis://localhost:6379/0
PERSIST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vulture
PERSIST_STREAM=telemetry:ingest
PERSIST_GROUP=postgres-persister
PERSIST_CONSUMER=persister-local
PERSIST_BATCH_SIZE=500
PERSIST_BLOCK_MS=1000
PERSIST_SOCKET_TIMEOUT_SECONDS=5
PERSIST_POOL_MIN_SIZE=1
PERSIST_POOL_MAX_SIZE=4
PERSIST_RETRY_INITIAL_SECONDS=0.25
PERSIST_RETRY_MAX_SECONDS=30
PERSIST_SHUTDOWN_TIMEOUT_SECONDS=10
PERSIST_LOG_LEVEL=INFO
# Optional inclusive cutoff for normalized timestamps from the OLD receiver.
# Leave empty for strict validation. Configure separately for PERSIST_STREAM.
PERSIST_LEGACY_MAX_ID=
